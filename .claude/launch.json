{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "overbooked",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/server.mjs",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "overbooked-web",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8790",
        "--bind",
        "127.0.0.1",
        "--directory",
        "dist/web"
      ],
      "port": 8790
    }
  ]
}